{
    "name": "linkguard/linkguard-ai",
    "description": "A deterministic suspicious-link investigation prototype.",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.2",
        "dompdf/dompdf": "^3.1",
        "khaled.alshamaa/ar-php": "^6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "LinkGuard\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
